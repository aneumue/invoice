<Window x:Class="InvoiceAPP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InvoiceAPP"
        Width="1200"
        Height="850"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">

            <Button x:Name="PreviousInvoiceButton"
                    Content="◀ Invoice"
                    Click="PreviousInvoice_Click"
                    Margin="0,0,8,0"
                    Padding="12,6"/>

            <Button x:Name="NextInvoiceButton"
                    Content="Invoice ▶"
                    Click="NextInvoice_Click"
                    Margin="0,0,20,0"
                    Padding="12,6"/>

            <Button x:Name="PreviousPageButton"
                    Content="◀ Page"
                    Click="PreviousPage_Click"
                    Margin="0,0,8,0"
                    Padding="12,6"/>

            <Button x:Name="NextPageButton"
                    Content="Page ▶"
                    Click="NextPage_Click"
                    Padding="12,6"/>

            <TextBlock x:Name="PageText"
                       Text="Page -/-"
                       Margin="20,7,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock x:Name="InvoiceText"
                       Text="No invoice loaded"
                       FontSize="16"
                       FontWeight="SemiBold"/>

            <TextBlock x:Name="StatusText"
                       Text="Starting..."
                       Foreground="#666666"
                       Margin="0,3,0,0"/>
        </StackPanel>

        <Border Grid.Row="2"
                Background="#333333"
                BorderBrush="#AAAAAA"
                BorderThickness="1">

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">

                <Image x:Name="PdfImage"
                       Stretch="None"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>