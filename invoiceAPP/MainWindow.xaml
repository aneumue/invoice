<Window x:Class="InvoiceAPP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InvoiceAPP"
        Width="1200"
        Height="750">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button x:Name="StartButton"
                Grid.Row="0"
                Width="160"
                Height="40"
                Margin="0,0,0,10"
                HorizontalAlignment="Left"
                Click="StartPipeline_Click">
            Start pipeline
        </Button>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="Gray"
                    BorderThickness="1">

                <ScrollViewer Grid.Row="1" 
                            HorizontalScrollBarVisibility="Auto" 
                            VerticalScrollBarVisibility="Auto">
                    <Image x:Name="InvoiceImage"
                        Stretch="Uniform">
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                        </Image.RenderTransform>
                    </Image>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="LightGray" />

            <Grid Grid.Column="2"
                  Margin="10,0,0,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0"
                        Margin="0,0,0,10">

                    <Button Width="140"
                            Height="40"
                            Margin="0,0,10,5"
                            Tag="Spesenrechnung"
                            Click="SetInvoiceType_Click">
                        Spesenrechnung
                    </Button>

                    <Button Width="140"
                            Height="40"
                            Margin="0,0,10,5"
                            Tag="Warenrechnung"
                            Click="SetInvoiceType_Click">
                        Warenrechnung
                    </Button>

                    <ComboBox x:Name="CompanySelector"
                            Width="120"
                            Height="40"
                            Margin="0,0,10,5"
                            IsEditable="False" />

                    <Button Width="120"
                            Height="40"
                            Margin="0,0,10,5"
                            Click="EditCompany_Click">
                        Edit company
                    </Button>

                    <Button Width="100"
                            Height="40"
                            Margin="0,0,10,5"
                            Click="MoveInvoices_Click">
                        Move
                    </Button>
                </WrapPanel>

                <DataGrid x:Name="InvoiceTable"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionChanged="InvoiceTable_SelectionChanged">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="File"
                                            Binding="{Binding FilePath}"
                                            Width="2*" />

                        <DataGridTextColumn Header="Company"
                                            Binding="{Binding Company}"
                                            Width="*" />

                        <DataGridTextColumn Header="Invoice type"
                                            Binding="{Binding InvoiceType}"
                                            Width="*" />

                        <DataGridTextColumn Header="Processed with"
                                            Binding="{Binding ProcessedWith}"
                                            Width="*" />

                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding Status}"
                                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</Window>